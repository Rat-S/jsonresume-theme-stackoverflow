{
  "name": "jsonresume-theme-folio",
  "version": "1.3.0",
  "description": "A compact, print-optimized JSON Resume theme for professionals. Clean inline header, unified contact bar, and PDF-first layout.",
  "author": "Jay S (deadrat)",
  "scripts": {
    "build": "node build.js",
    "export": "node bin/export.js",
    "test": "npm run build && jest --coverage --verbose",
    "updateTestSnapshots": "npm run build && jest --updateSnapshot"
  },
  "bin": {
    "folio-export": "./bin/export.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deadrat-in/jsonresume-theme-folio.git"
  },
  "homepage": "https://github.com/deadrat-in/jsonresume-theme-folio#readme",
  "bugs": {
    "url": "https://github.com/deadrat-in/jsonresume-theme-folio/issues"
  },
  "keywords": [
    "jsonresume",
    "resume",
    "theme",
    "pdf",
    "print",
    "professional",
    "compact"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!svelte)"
    ]
  },
  "peerDependencies": {
    "puppeteer": ">=21.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jsonresume/schema": "^1.2.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.4",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "esbuild": "^0.27.3",
    "html-validate": "^8.28.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "puppeteer": "^24.42.0",
    "semantic-release": "^25.0.3",
    "svelte": "^5.28.2",
    "typescript": "^5.7.0"
  }
}
